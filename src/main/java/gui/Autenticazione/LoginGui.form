<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Autenticazione.LoginGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-13881804"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="3730a" binding="buttonPanel" layout-manager="FormLayout">
        <rowspec value="center:d:grow"/>
        <rowspec value="top:4dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:4dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <colspec value="fill:d:grow"/>
        <colspec value="left:4dlu:noGrow"/>
        <colspec value="fill:d:grow"/>
        <colspec value="left:4dlu:noGrow"/>
        <colspec value="fill:d:grow"/>
        <constraints border-constraint="South"/>
        <properties>
          <background color="-13881804"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="b9202" class="javax.swing.JButton" binding="accediButton">
            <constraints>
              <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <background color="-2500135"/>
              <foreground color="-16448233"/>
              <text value="accedi"/>
            </properties>
          </component>
          <component id="525ac" class="javax.swing.JButton" binding="registratiButton">
            <constraints>
              <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <background color="-2500135"/>
              <foreground color="-16448233"/>
              <text value="registrati"/>
            </properties>
          </component>
          <hspacer id="fd53d">
            <constraints>
              <grid row="2" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <forms defaultalign-horz="false"/>
            </constraints>
          </hspacer>
          <hspacer id="2c60b">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <forms defaultalign-horz="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <grid id="91d49" binding="textFieldPanel" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-13881804"/>
          <foreground color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="cc7d7" class="javax.swing.JLabel" binding="emailLabel">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <foreground color="-262657"/>
              <text value="Email:"/>
            </properties>
          </component>
          <component id="e6a25" class="javax.swing.JTextField" binding="emailTextField">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="e5719" class="javax.swing.JLabel" binding="passwordLabel">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <foreground color="-262657"/>
              <text value="Password:"/>
            </properties>
          </component>
          <component id="4e47f" class="javax.swing.JPasswordField" binding="passwordPasswordField">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <hspacer id="d4355">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <hspacer id="ee6f5">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <component id="a17ce" class="javax.swing.JLabel" binding="tittoloLabel">
        <constraints border-constraint="North"/>
        <properties>
          <background color="-13881804"/>
          <font size="20" style="1"/>
          <foreground color="-262657"/>
          <horizontalAlignment value="0"/>
          <text value="Login"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
