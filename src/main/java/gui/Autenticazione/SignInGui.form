            </constraints>
            <properties>
              <background color="-2500135"/>
              <foreground color="-16448233"/>
              <text value="registrati "/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="ae89e" binding="singInPanel" layout-manager="GridLayoutManager" row-count="5" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
