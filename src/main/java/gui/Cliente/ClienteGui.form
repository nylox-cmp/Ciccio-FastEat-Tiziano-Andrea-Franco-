<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Cliente.ClienteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="537" height="400"/>
    </constraints>
    <properties>
      <background color="-262657"/>
    </properties>
    <border type="none">
      <font style="1"/>
      <title-color color="-13881804"/>
    </border>
    <children>
      <grid id="902b8" binding="ristorantiPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="etched" title="Ristoranti">
          <font style="1"/>
          <title-color color="-13881804"/>
        </border>
        <children>
          <grid id="8201e" binding="buttonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints border-constraint="South"/>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="fe1fd" class="javax.swing.JButton" binding="apriButton" default-binding="true">
                <constraints/>
                <properties>
                  <background color="-13881804"/>
                  <enabled value="true"/>
                  <foreground color="-262657"/>
                  <text value="Apri ristorante"/>
                </properties>
              </component>
            </children>
          </grid>
          <scrollpane id="e37fa" binding="ristorantiJScrollPane">
            <constraints border-constraint="Center"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="ac676" class="javax.swing.JList" binding="ristorantiLista">
                <constraints/>
                <properties>
                  <background color="-3025959"/>
                  <foreground color="-13881804"/>
                  <selectionMode value="0"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <grid id="ed51f" binding="ricercaPanel" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints border-constraint="North"/>
            <properties>
              <background color="-262657"/>
              <enabled value="true"/>
            </properties>
            <border type="etched">
              <font style="1"/>
              <title-color color="-13881804"/>
            </border>
            <children>
              <component id="708c6" class="javax.swing.JTextField" binding="searchTextField">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-13881804"/>
                  <foreground color="-262657"/>
                  <text value=""/>
                  <toolTipText value=" "/>
                </properties>
              </component>
              <component id="8a652" class="javax.swing.JButton" binding="searchButton">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-13881804"/>
                  <foreground color="-262657"/>
                  <text value="Cerca "/>
                </properties>
              </component>
              <hspacer id="fdaca">
                <constraints>
                  <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
              <component id="2f44f" class="javax.swing.JLabel" binding="nomeIndrizzoLabel">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <foreground color="-13881804"/>
                  <text value="nome/indrizzo"/>
                </properties>
              </component>
              <hspacer id="13194">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
