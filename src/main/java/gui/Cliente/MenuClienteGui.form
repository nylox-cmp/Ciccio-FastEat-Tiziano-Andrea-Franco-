<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Cliente.MenuClienteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="889" height="400"/>
    </constraints>
    <properties>
      <background color="-262657"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="dc4bd" binding="infoPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties>
          <background color="-262657"/>
          <enabled value="true"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="3a2e8" class="javax.swing.JLabel" binding="infoMenuLabel">
            <constraints/>
            <properties>
              <foreground color="-13881804"/>
              <text value="nome"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="a6a91" binding="prodottiPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="2b8dc" binding="buttonPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints border-constraint="South"/>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="645fc" class="javax.swing.JButton" binding="tornaIndietroButton" default-binding="true">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-13881804"/>
                  <foreground color="-262657"/>
                  <text value="Torna Indietro "/>
                </properties>
              </component>
              <grid id="fe0d7" binding="ordinePanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-262657"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="e79dd" class="javax.swing.JLabel" binding="indrizzoConsegnaLabel">
                    <constraints/>
                    <properties>
                      <foreground color="-13881804"/>
                      <text value="indirizzo consegna "/>
                    </properties>
                  </component>
                  <component id="dcfd6" class="javax.swing.JTextField" binding="indirizzoTextField">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <columns value="5"/>
                      <editable value="true"/>
                      <foreground color="-262657"/>
                    </properties>
                  </component>
                  <component id="869b4" class="javax.swing.JButton" binding="creaOrdineButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="Crea Ordine"/>
                    </properties>
                  </component>
                  <component id="ca18c" class="javax.swing.JButton" binding="diminuisciQuantitaButton">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="-"/>
                    </properties>
                  </component>
                  <component id="c309f" class="javax.swing.JLabel" binding="quantitaProdottoLabel">
                    <constraints/>
                    <properties>
                      <foreground color="-13881804"/>
                      <text value="0"/>
                    </properties>
                  </component>
                  <component id="a6854" class="javax.swing.JButton" binding="aumentaQuantitaButton">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="+"/>
                    </properties>
                  </component>
                  <component id="f558c" class="javax.swing.JComboBox" binding="ordiniComboBox">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                    </properties>
                  </component>
                  <component id="673d6" class="javax.swing.JButton" binding="aggungiAllOrdineButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="Aggungi all'Ordine"/>
