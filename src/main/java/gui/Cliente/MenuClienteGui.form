                  </component>
                  <component id="16493" class="javax.swing.JButton" binding="rimuoviDallOridneButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="rimuovi dall'Oridne"/>
