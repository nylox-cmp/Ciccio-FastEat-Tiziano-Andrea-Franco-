              </grid>
              <component id="1ce13" class="javax.swing.JButton" binding="tornaIndietroButton">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-13881804"/>
                  <foreground color="-262657"/>
                  <text value="torna indietro"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="e4621" binding="infoMenuPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties>
          <background color="-262657"/>
