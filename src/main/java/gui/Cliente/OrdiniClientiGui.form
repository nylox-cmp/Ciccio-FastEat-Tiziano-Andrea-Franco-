<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Cliente.OrdiniClientiGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="734" height="400"/>
    </constraints>
    <properties>
      <background color="-262657"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="7f8b1" binding="bottomPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-262657"/>
          <foreground color="-3187658"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="9d9ef" binding="ordiniPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
