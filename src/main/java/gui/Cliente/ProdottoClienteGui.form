          </component>
          <component id="f50e5" class="javax.swing.JComboBox" binding="ordiniComboBox">
            <constraints/>
            <properties>
              <background color="-13881804"/>
              <foreground color="-262657"/>
              <minimumSize width="300" height="30"/>
