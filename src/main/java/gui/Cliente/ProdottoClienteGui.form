<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Cliente.ProdottoClienteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="FormLayout">
    <rowspec value="center:d:grow"/>
    <rowspec value="top:4dlu:noGrow"/>
    <rowspec value="center:max(d;4px):noGrow"/>
    <colspec value="fill:d:grow"/>
    <constraints>
      <xy x="20" y="20" width="1025" height="400"/>
    </constraints>
    <properties>
      <background color="-262657"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="7436b" binding="quantitaButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <forms/>
        </constraints>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="ab28b" class="javax.swing.JButton" binding="diminuisciQuantitaButton">
            <constraints/>
            <properties>
              <background color="-13881804"/>
              <foreground color="-262657"/>
              <text value="-"/>
            </properties>
          </component>
          <component id="baef2" class="javax.swing.JLabel" binding="quantitaProdottoLabel">
            <constraints/>
            <properties>
              <foreground color="-16448233"/>
              <text value="0"/>
            </properties>
          </component>
          <component id="8cbc7" class="javax.swing.JButton" binding="aumentaQuantitaButton">
            <constraints/>
            <properties>
              <background color="-13881804"/>
              <foreground color="-262657"/>
              <text value="+"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="5e9f2" binding="ordinmeButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <forms/>
        </constraints>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="6d46f" class="javax.swing.JLabel" binding="indirizzoLabel">
            <constraints/>
            <properties>
              <foreground color="-16448233"/>
              <text value="indirizzo"/>
            </properties>
          </component>
          <component id="5a06" class="javax.swing.JTextField" binding="indirizzoTextField">
            <constraints/>
            <properties>
              <background color="-13881804"/>
              <columns value="10"/>
              <foreground color="-262657"/>
            </properties>
          </component>
          <component id="287f9" class="javax.swing.JButton" binding="creaOrdineButton" default-binding="true">
            <constraints/>
            <properties>
              <background color="-13881804"/>
              <foreground color="-262657"/>
              <preferredSize width="105" height="34"/>
