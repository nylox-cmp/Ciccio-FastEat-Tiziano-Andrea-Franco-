<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Cliente.RistoranteClienteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="415" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="af161" binding="MenuPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="etched" title="Menu">
          <font style="1"/>
          <title-color color="-13881804"/>
        </border>
        <children>
          <scrollpane id="f3832" binding="menuScrollPane">
            <constraints border-constraint="Center"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="5ccb" class="javax.swing.JList" binding="menuJlist">
                <constraints/>
                <properties>
                  <background color="-2894377"/>
                  <foreground color="-13881804"/>
                  <selectionMode value="0"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <grid id="fff00" binding="buttonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints border-constraint="South"/>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="9d65f" class="javax.swing.JButton" binding="tornaIndietroButton">
                <constraints/>
                <properties>
                  <background color="-13881804"/>
                  <enabled value="true"/>
                  <foreground color="-262657"/>
                  <text value="torna indietro "/>
                </properties>
              </component>
              <component id="c6297" class="javax.swing.JButton" binding="apriButton">
                <constraints/>
                <properties>
                  <background color="-13881804"/>
                  <enabled value="true"/>
                  <foreground color="-262657"/>
                  <text value="apri menu"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="8a2d4" binding="topPanelClienti" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="eccdd" class="javax.swing.JLabel" binding="infoRistoranteClienteLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-16448233"/>
              <foreground color="-16448233"/>
              <text value="nome + indirizzo"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
