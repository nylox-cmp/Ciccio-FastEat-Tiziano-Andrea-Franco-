<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Dipedente.DipedenteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1260" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="2f8a6" binding="BottomPanel" layout-manager="FormLayout">
        <rowspec value="center:d:noGrow"/>
        <rowspec value="top:4dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:4dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <colspec value="fill:d:grow"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="3c09c" class="javax.swing.JLabel" binding="tittoloLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <font size="16" style="1"/>
              <horizontalAlignment value="0"/>
              <text value="non sei ancora un dipedente,effettua la registrazione del ristorante o tramite il codice di autenticazione del ristorante richiedi di diventare dipedente"/>
            </properties>
          </component>
          <grid id="14376" binding="ristorantePanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="1b94f" class="javax.swing.JLabel" binding="nomeLabel">
                <constraints/>
                <properties>
                  <text value="nome ristorante"/>
                </properties>
              </component>
              <component id="1ca6e" class="javax.swing.JTextField" binding="nomeTextField">
                <constraints/>
                <properties>
                  <columns value="10"/>
                </properties>
              </component>
              <component id="21341" class="javax.swing.JLabel" binding="indirizzoLabel">
                <constraints/>
                <properties>
                  <text value="indirizzo"/>
                </properties>
              </component>
              <component id="417e9" class="javax.swing.JTextField" binding="indirizzoTextField">
                <constraints/>
                <properties>
                  <columns value="10"/>
                </properties>
              </component>
              <component id="7af30" class="javax.swing.JButton" binding="RegistraButton">
                <constraints/>
                <properties>
                  <text value="registra ristorante"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="2e2b8" binding="richiestaDipedentePanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="2ba76" class="javax.swing.JLabel" binding="codiceAutenticazioneLabel">
                <constraints/>
                <properties>
                  <text value="codice autenticazione"/>
                </properties>
              </component>
              <component id="4dea8" class="javax.swing.JTextField" binding="codiceAutenticazioneTextField">
                <constraints/>
                <properties>
                  <columns value="10"/>
                </properties>
              </component>
              <component id="d6cd7" class="javax.swing.JButton" binding="richiestaDipedenteButton">
                <constraints/>
                <properties>
                  <text value="richiedi di diventare dipedente"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
