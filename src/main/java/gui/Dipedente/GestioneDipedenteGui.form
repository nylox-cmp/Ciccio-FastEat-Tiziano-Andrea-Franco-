<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Dipedente.GestioneDipedenteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="630" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="27c8" binding="bottomPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="cbbf2" binding="richiesteAssunzioniPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="line" title="Richieste assunzioni">
              <font style="1"/>
              <title-color color="-16448233"/>
              <color color="-13881804"/>
            </border>
            <children>
              <grid id="5d86e" binding="assunzioiniButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints border-constraint="South"/>
                <properties>
                  <background color="-262657"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="519b" class="javax.swing.JButton" binding="rifiutaRichestaButton">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="rifiuta "/>
                    </properties>
                  </component>
                  <component id="abbcd" class="javax.swing.JButton" binding="accettaRichiestaButton">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <hideActionText value="false"/>
                      <text value="accetta"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <scrollpane id="8340a" binding="richiestaAssunzioniJScrollPane">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="68162" class="javax.swing.JList" binding="richiestaAssunziniLista">
                    <constraints/>
                    <properties>
                      <background color="-2500135"/>
                      <foreground color="-16448233"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="65b6a" binding="dipedentiPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="line" title="Dipedenti Subordinati">
              <font style="1"/>
              <title-color color="-16448233"/>
              <color color="-13881804"/>
            </border>
            <children>
              <grid id="95fa5" binding="DipedentiButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints border-constraint="South"/>
                <properties>
                  <background color="-262657"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="126a1" class="javax.swing.JLabel" binding="ruoloLabel">
                    <constraints/>
                    <properties>
                      <background color="-16448233"/>
                      <foreground color="-16448233"/>
                      <text value="modifica ruolo"/>
                    </properties>
                  </component>
                  <component id="25f09" class="javax.swing.JComboBox" binding="seletoreRuoloCombox">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <model>
                        <item value="BASE"/>
                        <item value="GESTIONALE"/>
                      </model>
                    </properties>
                  </component>
                  <component id="71fb1" class="javax.swing.JButton" binding="licenziaButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="licenzia"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <scrollpane id="5d2dc" binding="subordinatiJscrollPane">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="4702f" class="javax.swing.JList" binding="subordinatiLista">
                    <constraints/>
                    <properties>
                      <background color="-2500135"/>
                      <foreground color="-16448233"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
