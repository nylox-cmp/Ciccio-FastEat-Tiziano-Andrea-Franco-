<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Dipedente.OrdiniDipedenteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="484" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="91095" binding="bottomPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="b6e70" binding="riderPropostiPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none" title="Rider proposti consegna ordine"/>
            <children>
              <grid id="33a70" binding="riderPropostiButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints border-constraint="South"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="ac271" class="javax.swing.JButton" binding="rifiutaButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <text value="Rifiuta"/>
                    </properties>
                  </component>
                  <component id="b634f" class="javax.swing.JButton" binding="accettaButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <text value="Accetta"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="16393" class="javax.swing.JList" binding="riderPropostiOrdineLista">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
            </children>
          </grid>
          <grid id="66886" binding="ordiniDipedentiPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none" title="Ordini "/>
            <children>
              <grid id="48484" binding="ordiniDipedentiButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints border-constraint="South"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="45706" class="javax.swing.JButton" binding="cancellaButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <text value="Cancella"/>
                    </properties>
                  </component>
                  <component id="f1f7" class="javax.swing.JButton" binding="senglaProntoAlRitiroButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <text value="Sengla Pronto Al Ritiro"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="3a9e7" class="javax.swing.JList" binding="ordiniLista">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
