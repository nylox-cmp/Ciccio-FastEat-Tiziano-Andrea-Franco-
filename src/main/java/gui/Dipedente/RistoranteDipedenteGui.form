<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Dipedente.RistoranteDipedenteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="595" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="53c23" binding="BottomPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="dc330" binding="TopPanelDipedenti" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints border-constraint="North"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="f662f" class="javax.swing.JButton" binding="TornaIndietroDipedentiButton">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Torna Indietro"/>
                </properties>
              </component>
              <component id="a0317" class="javax.swing.JLabel" binding="RistoranteInfoDipedentiLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="nome + indirizzo + codice_autenticazione"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="9825b" binding="DipedentiPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints border-constraint="Center"/>
            <properties/>
            <border type="none"/>
            <children>
              <grid id="4aaca" binding="ModificaPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints border-constraint="North"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="4c495" class="javax.swing.JLabel" binding="NomeLabel">
                    <constraints/>
                    <properties>
                      <text value="nome"/>
                    </properties>
                  </component>
                  <component id="6b2b2" class="javax.swing.JTextField" binding="NomeTextField">
                    <constraints/>
                    <properties>
                      <columns value="10"/>
                    </properties>
                  </component>
                  <component id="3ee32" class="javax.swing.JLabel" binding="IndirizzoLabel">
                    <constraints/>
                    <properties>
                      <text value="indirizzo"/>
                    </properties>
                  </component>
                  <component id="cecef" class="javax.swing.JTextField" binding="IndirizzoTextField">
                    <constraints/>
                    <properties>
                      <columns value="10"/>
                    </properties>
                  </component>
                  <component id="8c960" class="javax.swing.JButton" binding="modificaButton" default-binding="true">
                    <constraints/>
                    <properties>
                      <text value="Modifica"/>
                    </properties>
                  </component>
                  <component id="4ca6c" class="javax.swing.JButton" binding="cancellaRistoranteButton">
                    <constraints/>
                    <properties>
                      <text value="Cancella"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="bb930" class="javax.swing.JList" binding="MenuDipedentiLista">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
