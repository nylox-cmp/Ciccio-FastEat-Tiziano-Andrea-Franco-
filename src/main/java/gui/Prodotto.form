<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Prodotto">
  <grid id="27dc6" binding="MainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="544" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="54966" binding="TopPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="20ced" class="javax.swing.JButton" binding="areaClientiButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Area Clienti"/>
            </properties>
          </component>
          <component id="4fb61" class="javax.swing.JButton" binding="areaRiderButton" default-binding="true">
