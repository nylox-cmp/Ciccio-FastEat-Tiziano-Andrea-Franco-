              <text value="Logout"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="b7f02" binding="Area" layout-manager="CardLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="3b872" binding="AreaClienti" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <card name="Clienti"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <grid id="b16d5" binding="TopPanelClienti" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints border-constraint="North"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="962c9" class="javax.swing.JButton" binding="tornaIndietroClienteButton">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Torna Indietro"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="87006" class="javax.swing.JLabel" binding="InfoPrdottoClienteLabel">
                <constraints border-constraint="Center"/>
