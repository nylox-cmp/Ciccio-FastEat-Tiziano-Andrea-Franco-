                  <grid id="b8258" binding="ModificaProttoPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
