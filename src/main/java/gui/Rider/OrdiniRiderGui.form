<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Rider.OrdiniRiderGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="797" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="5a3dd" binding="bottomPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="83df5" binding="ordiniInCaricoPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="line" title="ordini presi in carico">
              <font style="1"/>
              <title-color color="-16448233"/>
              <color color="-13881804"/>
            </border>
            <children>
              <grid id="dacd4" binding="buttonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints border-constraint="South"/>
                <properties>
                  <background color="-262657"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="33837" class="javax.swing.JButton" binding="confermaConsegnaButton">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="Conferma Consegna"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <scrollpane id="afc8d">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="1e60f" class="javax.swing.JList" binding="ordiniDaConsegnareLista">
                    <constraints/>
                    <properties>
                      <background color="-2894377"/>
                      <foreground color="-16448233"/>
                      <selectionMode value="0"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="58e98" binding="richiestaOrdiniPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="line" title="Ordini che potresti prendere in carico">
              <font style="1"/>
              <title-color color="-16448233"/>
              <color color="-13881804"/>
            </border>
            <children>
              <grid id="2abf5" binding="richiestaButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
                <constraints border-constraint="South"/>
                <properties>
                  <background color="-262657"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="e7055" class="javax.swing.JButton" binding="creaRichiestaOrdineButton">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="Crea Richiesta di Consegnare Ordine"/>
                    </properties>
                  </component>
                  <component id="45aa6" class="javax.swing.JButton" binding="cancellaRichiestaOrdineButton">
                    <constraints/>
                    <properties>
                      <background color="-13881804"/>
                      <foreground color="-262657"/>
                      <text value="Cancella Richiesta di Consegna Ordine"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <scrollpane id="81b3c">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="fdd9c" class="javax.swing.JList" binding="ordiniPropostiLista">
                    <constraints/>
                    <properties>
                      <background color="-2500135"/>
                      <foreground color="-16448233"/>
                      <selectionMode value="0"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="835d" binding="contenutoOrdinePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="line" title="Contenuto Ordine">
              <font style="1"/>
              <title-color color="-16448233"/>
            </border>
            <children/>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
