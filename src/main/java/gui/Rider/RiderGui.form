<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Rider.RiderGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="696" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="46c23" binding="bottomPanel" layout-manager="FormLayout">
        <rowspec value="center:max(d;4px):noGrow"/>
        <rowspec value="top:4dlu:noGrow"/>
        <rowspec value="center:max(d;4px):noGrow"/>
        <colspec value="fill:d:grow"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-262657"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="414a5" class="javax.swing.JLabel" binding="titoloLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <background color="-262657"/>
              <font size="18" style="1"/>
              <foreground color="-3187658"/>
              <horizontalAlignment value="0"/>
              <horizontalTextPosition value="0"/>
              <text value="effettua la registrazione per diventare rider"/>
            </properties>
          </component>
          <grid id="d928e" binding="registrazioneButtonPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
              <forms/>
            </constraints>
            <properties>
              <background color="-262657"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="195b" class="javax.swing.JLabel" binding="mezzoTrasportoLabel">
                <constraints/>
                <properties>
                  <foreground color="-16448233"/>
                  <text value="mezzo trasporto"/>
                </properties>
              </component>
              <component id="12d4f" class="javax.swing.JTextField" binding="mezzoTrasportoTextField">
                <constraints/>
                <properties>
                  <background color="-13881804"/>
                  <columns value="10"/>
                  <foreground color="-262657"/>
                </properties>
              </component>
              <component id="a08de" class="javax.swing.JButton" binding="registratiButton">
                <constraints/>
                <properties>
                  <background color="-13881804"/>
                  <foreground color="-262657"/>
                  <text value="registrati"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
