<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.customWidget.ContenutoOrdineGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-262657"/>
    </properties>
    <border type="none"/>
    <children>
      <scrollpane id="32d08" binding="cotenutoOrdineJScrollPane">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="2ac3c" class="javax.swing.JList" binding="contenutoOrdineLista">
            <constraints/>
            <properties>
              <background color="-2500135"/>
              <foreground color="-16448233"/>
              <selectionMode value="0"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
