<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.customWidget.DashboardClienteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
    <constraints>
      <xy x="20" y="20" width="500" height="44"/>
    </constraints>
    <properties>
      <background color="-13881804"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="263ed" class="javax.swing.JLabel" binding="puntiFedeltaLabel">
        <constraints/>
        <properties>
          <foreground color="-262657"/>
          <text value="punti fedelta : 0"/>
        </properties>
      </component>
      <component id="9112" class="javax.swing.JComboBox" binding="areaComboBox">
        <constraints/>
        <properties>
          <background color="-2500135"/>
          <foreground color="-13881804"/>
          <model>
            <item value="Home"/>
            <item value="Ordini"/>
          </model>
        </properties>
      </component>
    </children>
  </grid>
</form>
