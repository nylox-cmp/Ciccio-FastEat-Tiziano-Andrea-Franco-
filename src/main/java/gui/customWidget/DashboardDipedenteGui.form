<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.customWidget.DashboardDipedenteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="5e2f8" binding="dashboardPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="6ba6f" class="javax.swing.JLabel" binding="tittoloLabel">
            <constraints/>
            <properties>
              <text value="gestione"/>
            </properties>
          </component>
          <component id="dfebe" class="javax.swing.JComboBox" binding="areaGestioneComboBox">
            <constraints/>
            <properties/>
          </component>
        </children>
      </grid>
      <grid id="5a1af" binding="placeholderPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
    </children>
  </grid>
</form>
