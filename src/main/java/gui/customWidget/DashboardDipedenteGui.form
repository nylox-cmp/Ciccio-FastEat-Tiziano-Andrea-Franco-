<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.customWidget.DashboardDipedenteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="c08fe" binding="dashboardPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="2d415" class="javax.swing.JLabel" binding="tittoloLabel">
            <constraints/>
            <properties>
              <text value="gestione"/>
            </properties>
          </component>
          <component id="2d072" class="javax.swing.JComboBox" binding="areaGestioneComboBox">
            <constraints/>
            <properties>
              <model>
                <item value="Ordini"/>
                <item value="Ristorante"/>
                <item value="Dipedenti"/>
              </model>
            </properties>
          </component>
          <component id="e4a39" class="javax.swing.JButton" binding="tornaIndietroButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="torna indietro"/>
            </properties>
          </component>
          <component id="3a14c" class="javax.swing.JButton" binding="apriButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="apri"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
