<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.customWidget.DashboardDipedenteGui">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="645" height="59"/>
    </constraints>
    <properties>
      <background color="-13881804"/>
      <foreground color="-13881804"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="c08fe" binding="dashboardPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-13881804"/>
          <foreground color="-13881804"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="4f26" class="javax.swing.JLabel" binding="infoDipedente">
            <constraints/>
            <properties>
              <foreground color="-262657"/>
              <text value="nickname + ruolo"/>
            </properties>
          </component>
          <hspacer id="81eba">
            <constraints/>
          </hspacer>
          <component id="2d415" class="javax.swing.JLabel" binding="tittoloLabel">
            <constraints/>
            <properties>
              <background color="-262657"/>
              <foreground color="-262657"/>
              <text value="gestisci "/>
            </properties>
          </component>
          <component id="2d072" class="javax.swing.JComboBox" binding="areaGestioneComboBox">
            <constraints/>
            <properties>
              <background color="-2500135"/>
              <foreground color="-16448233"/>
              <model>
                <item value="Ordini"/>
                <item value="Ristorante"/>
                <item value="Dipedenti"/>
              </model>
            </properties>
          </component>
          <component id="e4a39" class="javax.swing.JButton" binding="tornaIndietroButton" default-binding="true">
            <constraints/>
            <properties>
              <background color="-2894377"/>
              <foreground color="-16448233"/>
              <text value="torna indietro"/>
            </properties>
          </component>
          <component id="3a14c" class="javax.swing.JButton" binding="apriButton" default-binding="true">
            <constraints/>
            <properties>
              <background color="-2500135"/>
              <enabled value="true"/>
              <foreground color="-16448233"/>
              <text value="apri"/>
            </properties>
          </component>
          <component id="85111" class="javax.swing.JButton" binding="licenziatiButton">
            <constraints/>
            <properties>
              <background color="-2500135"/>
              <enabled value="true"/>
              <foreground color="-16448233"/>
              <text value="licenziati"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
